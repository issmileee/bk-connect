# BK-Connect Environment Variables

# ===========================================
# DEVELOPMENT (SQLite)
# ===========================================
# DATABASE_URL="file:./dev.db"

# ===========================================
# PRODUCTION (PostgreSQL)
# ===========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Contoh lokal: postgresql://postgres:password@localhost:5432/bk_connect
# Contoh cloud (Supabase/Neon/Railway): postgresql://user:pass@host.region.provider.com:5432/dbname

DATABASE_URL="postgresql://postgres:password@localhost:5432/bk_connect"

# ===========================================
# NextAuth Configuration
# ===========================================
# Generate secret dengan: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-change-in-production-must-be-32-chars-minimum"
AUTH_TRUST_HOST=true

# ===========================================
# App URL
# ===========================================
# Development
NEXTAUTH_URL="http://localhost:3000"

# Production (ganti dengan domain Anda)
# NEXTAUTH_URL="https://yourdomain.com"

# ===========================================
# Optional: File Upload (jika menggunakan cloud storage)
# ===========================================
# UPLOAD_MAX_SIZE=5242880  # 5MB
# CLOUDINARY_URL="cloudinary://key:secret@cloud"
# atau
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY=""
# AWS_SECRET_KEY=""
